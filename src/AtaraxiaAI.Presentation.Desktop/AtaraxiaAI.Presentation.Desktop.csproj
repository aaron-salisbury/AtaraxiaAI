<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Avalonia desktop presentation for AtaraxiaAI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Base\Extensions\" />
    <Folder Include="Base\Services\UILayer\Dispatcher\" />
    <Folder Include="Base\Styles\" />
    <AvaloniaResource Include="Base\Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Base\Assets\Attributions.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Base\Assets\Attributions.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Deadpikle.AvaloniaProgressRing" Version="0.11.0" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtaraxiaAI.Business\AtaraxiaAI.Business.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Base\AppInfo.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AppInfo.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Base\AppInfo.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AppInfo.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
