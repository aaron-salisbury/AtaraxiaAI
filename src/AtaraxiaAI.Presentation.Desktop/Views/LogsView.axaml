<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AtaraxiaAI.Presentation.Desktop.LogsView"
			 xmlns:vm="clr-namespace:AtaraxiaAI.Presentation.Desktop.ViewModels"
			 x:DataType="vm:LogsViewModel"
			 Background="Transparent">

	<Grid>
		<ScrollViewer>
			<TextBlock Margin="5"
					   Background="Transparent"
					   TextWrapping="Wrap"
					   FontFamily="/Base/Assets/Fonts/ProFontWindows.ttf#ProFontWindows"
					   Text="{Binding LogMessages}" />
		</ScrollViewer>
	</Grid>
	
</UserControl>
