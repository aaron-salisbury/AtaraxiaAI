<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AtaraxiaAI.Presentation.Desktop.Views.SettingsView"
             xmlns:vm="clr-namespace:AtaraxiaAI.Presentation.Desktop.ViewModels"
			  xmlns:base="clr-namespace:AtaraxiaAI.Presentation.Desktop.Base"
			  xmlns:models="clr-namespace:AtaraxiaAI.Presentation.Desktop.Models"
			  xmlns:services="clr-namespace:AtaraxiaAI.Business.Services;assembly=AtaraxiaAI.Business"
             x:DataType="vm:SettingsViewModel"
			 Background="Transparent">

	<UserControl.DataTemplates>
		<!-- Shown while a chosen source is prepared, such as a one-time model download. -->
		<DataTemplate DataType="models:SourcePreparation">
			<StackPanel HorizontalAlignment="Right">
				<ProgressBar Width="125"
							 Height="6"
							 MinHeight="6"
							 Margin="0,8,0,0"
							 HorizontalAlignment="Right"
							 Minimum="0"
							 Maximum="100"
							 Value="{Binding Progress}"
							 IsIndeterminate="{Binding !IsProgressKnown}"
							 IsVisible="{Binding IsPreparing}"
							 Foreground="#cc5200" />
				<TextBlock Text="{Binding Status}"
						   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						   MaxWidth="200"
						   Margin="0,5,0,0"
						   FontSize="12"
						   TextAlignment="Right"
						   TextWrapping="Wrap"
						   HorizontalAlignment="Right" />
			</StackPanel>
		</DataTemplate>
	</UserControl.DataTemplates>

	<UserControl.Styles>
		<Style Selector="TextBlock.propertyLabel">
			<Setter Property="FontFamily" Value="/Base/Assets/Fonts/heavy_data.ttf#Heavy Data" />
			<Setter Property="FontSize" Value="17" />
			<Setter Property="Margin" Value="0,0,0,5" />
			<Setter Property="HorizontalAlignment" Value="Right" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer>
		<StackPanel HorizontalAlignment="Right" Margin="0,0,20,0">

			<TextBlock Text="Vision Capture Source" Classes="propertyLabel" />
			<ComboBox SelectedItem="{Binding SelectedVisionCaptureSource}"
					  ItemsSource="{Binding VisionCaptureSourceTypes}"
					  Width="125"
					  HorizontalAlignment="Right"
					  Margin="0,0,0,15">
				<ComboBox.ItemTemplate>
					<DataTemplate DataType="base:ComboBoxEnumItem">
						<TextBlock Text="{Binding Text}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<TextBlock Text="Sound Capture Source" Classes="propertyLabel" />
			<ComboBox SelectedItem="{Binding SelectedSoundCaptureSource}"
					  ItemsSource="{Binding SoundCaptureSourceTypes}"
					  Width="125"
					  HorizontalAlignment="Right"
					  Margin="0,0,0,15">
				<ComboBox.ItemTemplate>
					<DataTemplate DataType="base:ComboBoxEnumItem">
						<TextBlock Text="{Binding Text}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<TextBlock Text="Recognizer Source" Classes="propertyLabel" />
			<ComboBox SelectedItem="{Binding SelectedRecognizerSource}"
					  ItemsSource="{Binding RecognizerSourceTypes}"
					  Width="125"
					  HorizontalAlignment="Right">
				<ComboBox.ItemTemplate>
					<DataTemplate DataType="base:ComboBoxEnumItem">
						<TextBlock Text="{Binding Text}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<ContentControl Content="{Binding RecognizerPreparation}" HorizontalAlignment="Right" />

			<TextBlock Text="Speech Source" Classes="propertyLabel" Margin="0,15,0,5" />
			<ComboBox SelectedItem="{Binding SelectedSpeechSource}"
					  ItemsSource="{Binding SpeechSourceTypes}"
					  Width="125"
					  HorizontalAlignment="Right">
				<ComboBox.ItemTemplate>
					<DataTemplate DataType="base:ComboBoxEnumItem">
						<TextBlock Text="{Binding Text}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<ContentControl Content="{Binding SpeechPreparation}" HorizontalAlignment="Right" />

			<!-- Revealed for speech sources that offer a choice of voices. Choosing a voice plays a short sample. -->
			<StackPanel IsVisible="{Binding HasVoiceChoices}" HorizontalAlignment="Right" Margin="0,15,0,0">
				<TextBlock Text="Voice Gender" Classes="propertyLabel" />
				<ComboBox SelectedItem="{Binding SelectedVoiceGender}"
						  ItemsSource="{Binding VoiceGenderTypes}"
						  Width="125"
						  HorizontalAlignment="Right"
						  Margin="0,0,0,15">
					<ComboBox.ItemTemplate>
						<DataTemplate DataType="base:ComboBoxEnumItem">
							<TextBlock Text="{Binding Text}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<TextBlock Text="Voice" Classes="propertyLabel" />
				<ListBox SelectedItem="{Binding SelectedVoice}"
						 ItemsSource="{Binding Voices}"
						 Width="200"
						 MaxHeight="200"
						 HorizontalAlignment="Right"
						 Background="Transparent">
					<ListBox.ItemTemplate>
						<DataTemplate DataType="services:SpeechVoice">
							<TextBlock Text="{Binding DisplayName}" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>

		</StackPanel>
	</ScrollViewer>
</UserControl>
