<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AtaraxiaAI.Presentation.Desktop.VisionFeedView"
			 xmlns:cons="clr-namespace:AtaraxiaAI.Presentation.Desktop.Base.Converters;assembly=AtaraxiaAI.Presentation.Desktop"
			 xmlns:vm="clr-namespace:AtaraxiaAI.Presentation.Desktop.ViewModels"
			 x:DataType="vm:VisionFeedViewModel"
			 xmlns:i="using:Material.Icons.Avalonia"
			 Background="Transparent">

	<UserControl.Resources>
		<cons:BytesToBitmapConverter x:Key="bytesToBitmapConverter"/>
		<cons:StringToMaterialIconConverter x:Key="stringToMaterialIconConverter"/>
	</UserControl.Resources>

	<Grid RowDefinitions="*, Auto">
		<Image Grid.RowSpan="2"
               Stretch="Uniform"
               Source="{Binding FrameBuffer, Converter={StaticResource bytesToBitmapConverter}}"
               IsVisible="{Binding ShowCameraFeed}"/>

		<Button Grid.Row="1"
				Margin="10"
				Command="{Binding OnCameraClickCommand}"
				HorizontalAlignment="Right">

			<i:MaterialIcon Kind="{Binding CameraIcon, Converter={StaticResource stringToMaterialIconConverter}}" />
		</Button>
	</Grid>
	
</UserControl>
